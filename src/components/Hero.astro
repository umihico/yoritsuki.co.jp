---
import { HERO } from '../lib/content.js';
import T from './T.astro';
import { getLocale } from '../lib/i18n.js';
const locale = getLocale(Astro);
const cur = locale === 'en' ? HERO.title.en : HERO.title.ja;
const alt = locale === 'en' ? HERO.title.ja : HERO.title.en;
---
<section class="hero" id="hero">
  <div class="wrap">
    <p class="eyebrow mono">{HERO.eyebrow}</p>
    <h1>
      <span data-i18n>{cur[0]}<br /><span class="grad">{cur[1]}</span></span><template data-i18n-alt>{alt[0]}<br /><span class="grad">{alt[1]}</span></template>
    </h1>
    <div class="decls">
      {HERO.declarations.map((d, i) => (
        <p><span class="decl-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><T ja={d.ja} en={d.en} /></p>
      ))}
    </div>
  </div>
</section>
