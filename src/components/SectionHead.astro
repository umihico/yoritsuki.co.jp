---
// 全ページ共通のセクション見出し。h2 + 小さな青ラベルの1パターンのみ。
// 見出しは現在言語、青ラベルは反対言語（JA時: 英語ラベル / EN時: 日本語ラベル）。
// ラベルは T の引数を入れ替える（クロス）ことで反対言語を出す。
import T from './T.astro';
const { ja, en } = Astro.props;
---
<div class="section-head" data-reveal>
  <h2><T ja={ja} en={en} /></h2>
  <span class="section-en mono"><T ja={en} en={ja} /></span>
</div>
