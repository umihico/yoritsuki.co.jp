---
import { CAPABILITIES } from '../lib/content.js';
import SectionHead from './SectionHead.astro';
import T from './T.astro';
---
<section id="capabilities">
  <div class="wrap">
    <SectionHead ja="事業内容" en="Capabilities" />
    <div class="cards" data-reveal>
      {CAPABILITIES.map((card) => (
        <div class="card">
          <div class="glyph" aria-hidden="true">
            {card.glyph === 'research' && (
              <svg viewBox="0 0 88 56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                <line x1="10" y1="46" x2="78" y2="46" />
                <path d="M12 46 C 30 46 32 14 44 14 C 56 14 58 46 76 46" />
                <line x1="44" y1="16" x2="44" y2="46" stroke-dasharray="2 3.5" />
              </svg>
            )}
            {card.glyph === 'build' && (
              <svg viewBox="0 0 88 56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                <path d="M30 16 L14 28 L30 40" />
                <path d="M58 16 L74 28 L58 40" />
                <line x1="50" y1="13" x2="38" y2="43" />
              </svg>
            )}
            {card.glyph === 'trade' && (
              <svg viewBox="0 0 88 56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                <line x1="12" y1="46" x2="76" y2="46" />
                <line x1="26" y1="16" x2="26" y2="40" />
                <rect x="22" y="22" width="8" height="14" />
                <line x1="44" y1="10" x2="44" y2="44" />
                <rect x="40" y="17" width="8" height="20" />
                <line x1="62" y1="18" x2="62" y2="42" />
                <rect x="58" y="24" width="8" height="12" />
              </svg>
            )}
          </div>
          <h3><T ja={card.title.ja} en={card.title.en} /></h3>
          <p><T ja={card.body.ja} en={card.body.en} /></p>
        </div>
      ))}
    </div>
  </div>
</section>
