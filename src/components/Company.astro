---
import { COMPANY_ROWS } from '../lib/content.js';
import SectionHead from './SectionHead.astro';
import CompanyDd from './CompanyDd.astro';
import T from './T.astro';
import LangSwitch from './LangSwitch.astro';
---
<section id="company">
  <div class="wrap">
    <SectionHead ja="会社概要" en="Company" />
    <dl class="company-table" data-reveal>
      {COMPANY_ROWS.map((row) => (
        <div class="company-row">
          <dt><T ja={row.label.ja} en={row.label.en} /></dt>
          <dd>
            <LangSwitch>
              <Fragment slot="ja"><CompanyDd row={row} locale="ja" /></Fragment>
              <Fragment slot="en"><CompanyDd row={row} locale="en" /></Fragment>
            </LangSwitch>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
