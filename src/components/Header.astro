---
import Brand from './Brand.astro';
import T from './T.astro';
import { COMPANY } from '../lib/company.js';
import { NAV_ITEMS } from '../lib/content.js';
import { getLocale, localizedHref, alternatePaths } from '../lib/i18n.js';

const locale = getLocale(Astro);
const paths = alternatePaths(Astro.url.pathname);
// 言語トグル: 反対言語のURL（no-JS時は通常遷移）。JSありなら無遷移でDOM差替え。
const other = locale === 'en' ? 'ja' : 'en';
const otherHref = other === 'en' ? paths.en : paths.ja;
const otherShort = other === 'en' ? 'EN' : 'JA';
const otherLabel = other === 'en' ? 'Switch to English' : '日本語に切り替え';
const brandLabel = locale === 'en' ? `${COMPANY.name.en} home` : `${COMPANY.name.ja} トップページ`;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={localizedHref(locale, '/')} data-href-ja="/" data-href-en="/en/" aria-label={brandLabel}>
      <Brand />
    </a>
    <div class="nav-group">
      <nav class="site-nav" aria-label={locale === 'en' ? 'Global navigation' : 'グローバルナビゲーション'}>
        <span class="nav-indicator" aria-hidden="true" style="left:0;width:0;opacity:0"></span>
        {NAV_ITEMS.map((item) => (
          <a href={localizedHref(locale, item.href)} data-href-ja={item.href} data-href-en={localizedHref('en', item.href)}>
            <T ja={item.ja} en={item.en} />
          </a>
        ))}
      </nav>
      <div class="toggles" role="group" aria-label={locale === 'en' ? 'Language & theme' : '言語・テーマ設定'}>
        <a class="lang-btn mono" href={otherHref} data-lang-target={other} aria-label={otherLabel}>{otherShort}</a>
        <button type="button" class="theme-toggle" aria-label="テーマ切替 / Toggle theme">
          <span class="icon-moon" aria-hidden="true">🌙</span><span class="icon-sun" aria-hidden="true">☀️</span>
        </button>
      </div>
    </div>
  </div>
</header>
