---
import { HERO } from '../lib/content.js';
import T from './T.astro';
import LangSwitch from './LangSwitch.astro';

const esc = (s) =>
  String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// 折り返し時、読点「、」の直後だけを優先改行位置にする（各節は nowrap で内部改行を抑止）。
function breakAfterPunctHTML(text) {
  const parts = text.split('、');
  return parts
    .map((p, i) =>
      i < parts.length - 1
        ? `<span class="nowrap">${esc(p)}、</span>`
        : `<span class="nowrap">${esc(p)}</span>`,
    )
    .join('<wbr/>');
}
---
<section class="hero" id="hero">
  <div class="wrap">
    <p class="eyebrow mono">{HERO.eyebrow}</p>
    <h1>
      <LangSwitch>
        <Fragment slot="ja">{HERO.title.ja[0]}<br /><span class="grad">{HERO.title.ja[1]}</span></Fragment>
        <Fragment slot="en">{HERO.title.en[0]}<br /><span class="grad">{HERO.title.en[1]}</span></Fragment>
      </LangSwitch>
    </h1>
    <div class="decls">
      {HERO.declarations.map((d, i) => (
        <p><span class="decl-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{d.breakAfterPunct ? (
          <LangSwitch>
            <Fragment slot="ja"><span set:html={breakAfterPunctHTML(d.ja)} /></Fragment>
            <Fragment slot="en">{d.en}</Fragment>
          </LangSwitch>
        ) : (
          <T ja={d.ja} en={d.en} />
        )}</p>
      ))}
    </div>
  </div>
</section>
