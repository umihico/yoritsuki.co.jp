---
import { HERO } from '../lib/content.js';
import T from './T.astro';
import { getLocale } from '../lib/i18n.js';
const locale = getLocale(Astro);
const title = locale === 'en' ? HERO.title.en : HERO.title.ja;
---
<section class="hero" id="hero">
  <div class="wrap">
    <p class="eyebrow mono">{HERO.eyebrow}</p>
    <h1>
      <span>{title[0]}<br /><span class="grad">{title[1]}</span></span>
    </h1>
    <div class="decls">
      {HERO.declarations.map((d, i) => (
        <p><span class="decl-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><T ja={d.ja} en={d.en} /></p>
      ))}
    </div>
  </div>
</section>
