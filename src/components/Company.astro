---
import { COMPANY_ROWS } from '../lib/content.js';
import SectionHead from './SectionHead.astro';
import CompanyDd from './CompanyDd.astro';
import { getLocale, pick } from '../lib/i18n.js';

const locale = getLocale(Astro);
const alt = locale === 'en' ? 'ja' : 'en';
---
<section id="company">
  <div class="wrap">
    <SectionHead ja="会社概要" en="Company" />
    <dl class="company-table" data-reveal>
      {COMPANY_ROWS.map((row) => (
        <div class="company-row">
          <dt><span data-i18n>{pick(locale, row.label)}</span><template data-i18n-alt>{pick(alt, row.label)}</template></dt>
          <dd data-i18n><CompanyDd row={row} locale={locale} /></dd><template data-i18n-alt><CompanyDd row={row} locale={alt} /></template>
        </div>
      ))}
    </dl>
  </div>
</section>
