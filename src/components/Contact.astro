---
import { CONTACT } from '../lib/content.js';
import SectionHead from './SectionHead.astro';
import T from './T.astro';
import LangSwitch from './LangSwitch.astro';
// お問い合わせ。窓口は設けず、その旨と採用も行っていない旨のみ案内する。
---
<section id="contact">
  <div class="wrap">
    <SectionHead ja="お問い合わせ" en="Contact" />
    <div class="notice-box" data-reveal>
      <p>
        <LangSwitch>
          <Fragment slot="ja"><span class="nowrap">{CONTACT.body.ja[0]}</span><wbr /><span class="nowrap">{CONTACT.body.ja[1]}</span></Fragment>
          <Fragment slot="en"><span class="nowrap">{CONTACT.body.en[0]}</span><wbr /><span class="nowrap">{CONTACT.body.en[1]}</span></Fragment>
        </LangSwitch>
      </p>
      <p><T ja={CONTACT.note.ja} en={CONTACT.note.en} /></p>
    </div>
  </div>
</section>
