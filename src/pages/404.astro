---
import Layout from '../layouts/Layout.astro';
// 404 は未知パス全て（ja/en 問わず）に対して単一ファイルが返るため、両言語を併記する。
// トップと同じ配色・構成。数字は .notfound-code、リンクは既存の .notice-link を流用。
---
<Layout>
  <main class="notfound">
    <p class="notfound-code mono" aria-hidden="true">404</p>
    <p>ページが見つかりません<br />Page not found</p>
    <a href="/" class="notice-link">← トップに戻る / Back to home</a>
  </main>
</Layout>
