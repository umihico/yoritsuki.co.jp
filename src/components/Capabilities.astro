---
import { CAPABILITIES } from '../lib/content.js';
import SectionHead from './SectionHead.astro';
import T from './T.astro';
---
<section id="capabilities">
  <div class="wrap">
    <SectionHead ja="事業内容" en="Capabilities" />
    <div class="cards" data-reveal>
      {CAPABILITIES.map((card) => (
        <div class="card">
          <div class="glyph" aria-hidden="true">
            {card.glyph === 'web' && (
              <svg viewBox="0 0 88 56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                <circle cx="44" cy="28" r="12" />
                <ellipse cx="44" cy="28" rx="4.8" ry="12" />
                <line x1="32" y1="28" x2="56" y2="28" />
                <path d="M22 17 L11 28 L22 39" />
                <path d="M66 17 L77 28 L66 39" />
              </svg>
            )}
            {card.glyph === 'algo' && (
              <svg viewBox="0 0 88 56" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                <line x1="16" y1="6" x2="16" y2="48" />
                <line x1="16" y1="48" x2="74" y2="48" />
                <line x1="28" y1="14" x2="28" y2="40" />
                <rect x="24" y="20" width="8" height="14" />
                <line x1="44" y1="10" x2="44" y2="44" />
                <rect x="40" y="16" width="8" height="20" />
                <line x1="60" y1="18" x2="60" y2="42" />
                <rect x="56" y="24" width="8" height="12" />
              </svg>
            )}
          </div>
          <h3><T ja={card.title.ja} en={card.title.en} /></h3>
          <p><T ja={card.body.ja} en={card.body.en} /></p>
        </div>
      ))}
    </div>
  </div>
</section>
