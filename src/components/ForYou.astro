---
import { FOR_YOU } from '../lib/content.js';
import T from './T.astro';
---
<section id="for-you" style="padding-top:0">
  <div class="wrap">
    <div class="for-you" data-reveal>
      <p class="fy-label mono"><T ja={FOR_YOU.label.ja} en={FOR_YOU.label.en} /></p>
      <ul>
        {FOR_YOU.items.map((item) => (
          <li><T ja={item.ja} en={item.en} /></li>
        ))}
      </ul>
      <p class="fy-note"><T ja={FOR_YOU.note.ja} en={FOR_YOU.note.en} /></p>
    </div>
  </div>
</section>
