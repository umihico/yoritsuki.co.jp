---
// ブランドロックアップ（2段）。上段=現在言語、下段=反対言語。
// カタカナ「ヨリツキ」は上段(日本語)・下段(英語)いずれも正本ロゴ字形の
// インラインSVG(Wordmark)で描く。ローマ字「YORITSUKI」は従来どおり文字列。
import LangSwitch from './LangSwitch.astro';
import Wordmark from './Wordmark.astro';
---
<div class="name"><LangSwitch>
  <Fragment slot="ja"><Wordmark class="name-logo" /></Fragment>
  <Fragment slot="en">YORITSUKI</Fragment>
</LangSwitch></div>
<div class="roman mono"><LangSwitch>
  <Fragment slot="ja">YORITSUKI</Fragment>
  <Fragment slot="en"><Wordmark class="roman-logo" /></Fragment>
</LangSwitch></div>
