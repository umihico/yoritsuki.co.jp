---
import { CAPABILITIES, CAPABILITIES_NOTE } from '../lib/content.js';
import SectionHead from './SectionHead.astro';
import Glyph from './Glyph.astro';
import T from './T.astro';
---
<section id="capabilities">
  <div class="wrap">
    <SectionHead ja="事業内容" en="Capabilities" />
    <div class="cards" data-reveal>
      {CAPABILITIES.map((card) => (
        <div class="card">
          <div class="glyph" aria-hidden="true"><Glyph name={card.glyph} /></div>
          <h3><T ja={card.title.ja} en={card.title.en} /></h3>
          <p><T ja={card.body.ja} en={card.body.en} /></p>
        </div>
      ))}
    </div>
    <p class="cards-note" data-reveal><T ja={CAPABILITIES_NOTE.ja} en={CAPABILITIES_NOTE.en} /></p>
  </div>
</section>
